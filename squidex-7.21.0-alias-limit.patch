+using GraphQL.Validation;
+using GraphQLParser.AST;
+using Microsoft.Extensions.Options;
+using Squidex.Domain.Apps.Entities.Contents.GraphQL;
+
+namespace Squidex.Config.Web;
+
+public sealed class AliasLimitValidationRule(IOptions<GraphQLOptions> options) : ValidationRuleBase
+{
+    private readonly int maxAliases = options.Value.MaxAliases;
+
+    public override ValueTask<INodeVisitor?> GetPreNodeVisitorAsync(ValidationContext context)
+    {
+        if (maxAliases <= 0)
+        {
+            return default;
+        }
+
+        // The rule is a singleton, so the counter must live in a new visitor for every document.
+        var count = 0;
+
+        var visitor = new MatchingNodeVisitor<GraphQLField>((field, ctx) =>
+        {
+            if (field.Alias == null)
+            {
+                return;
+            }
+
+            count++;
+
+            if (count == maxAliases + 1)
+            {
+                ctx.ReportError(new ValidationError(
+                    $"The query contains more than {maxAliases} aliases, which is not allowed."));
+            }
+        });
+
+        return new ValueTask<INodeVisitor?>(visitor);
+    }
+}
